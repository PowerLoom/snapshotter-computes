      "metered": true,
      "sse": false,
      "params": [
        {
          "name": "token_address",
          "in": "path",
          "type": "string",
          "required": true
        },
        {
          "name": "pool_address",
          "in": "path",
          "type": "string",
          "required": true
        },
        {
          "name": "time_interval",
          "in": "path",
          "type": "integer",
          "required": true
        },
        {
          "name": "step_seconds",
          "in": "path",
          "type": "integer",
          "required": true
